# swatlas runtime/build configuration (non-sensitive). Copy to .env.
# This project has no secrets: no database, provider keys, or auth.

# Public hostname Traefik routes to this frontend. Suggested test convention:
# swatlas.home.iktdts.com. Production hostnames come from deployment config.
PROJECT_HOST=swatlas.home.iktdts.com
NEXT_PUBLIC_SITE_URL=https://swatlas.home.iktdts.com
NEXT_PUBLIC_ARTICLE_URL=https://thelatentsource.com/articles/mapping-star-wars-universe

APP_UID=1000
APP_GID=1000
FRONTEND_CONTAINER_NAME=swatlas-frontend
TRAEFIK_CERTRESOLVER=cloudflare
BUILD_VERSION=2026-09-24.1
